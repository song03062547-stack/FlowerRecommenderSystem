# คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml สำหรับรันในเครื่อง
# หรือนำค่าด้านล่างไปวางใน Streamlit Cloud -> App settings -> Secrets
# ห้าม commit secrets.toml ตัวจริง (ที่มีรหัสผ่านจริง) ขึ้น GitHub

[neo4j]
uri = "neo4j+s://YOUR_INSTANCE_ID.databases.neo4j.io"
username = "neo4j"
password = "YOUR_NEO4J_PASSWORD"
database = "neo4j"

[admin]
password = "ตั้งรหัสผ่าน Admin ของคุณเอง"
